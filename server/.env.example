PORT=5000

# Supabase — server-side only. Never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# scrape.do — residential proxy + JS render (used by api/_lib/scraper.mjs on Vercel)
# Get a token at https://dashboard.scrape.do
SCRAPE_DO_API_KEY=your-scrape-do-token

# API-Football (api-sports.io) — live scores, fixtures, lineups, events.
# Free tier = 100 requests/day. Get a free key at https://dashboard.api-football.com
API_FOOTBALL_KEY=your-api-football-key
